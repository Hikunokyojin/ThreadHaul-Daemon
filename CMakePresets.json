{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows x64 (Visual Studio, MSVC)",
      "binaryDir": "${sourceDir}/out/build",
      "installDir": "${sourceDir}/out/package",
      "cacheVariables": {
        "CMAKE_GENERATOR_PLATFORM": "x64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
